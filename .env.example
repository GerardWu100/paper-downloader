# Comma-separated direct PDF base URLs.
# Replace these placeholder values with provider-specific endpoints in your local .env file.
PAPER_DOWNLOADER_BASE_URLS=https://first.example,https://second.example

# Contact address sent to the Crossref and OpenAlex polite pools.
# Unset by default. Set your own address to get faster, more reliable
# provider responses; `paper-fetch-dois` requires it.
PAPER_DOWNLOADER_EMAIL=
